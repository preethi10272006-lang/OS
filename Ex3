#include <stdio.h>
#include "head.h"

void fcfs() {
    struct Process p[MAX], temp;
    int n, i, j;
    float avgWT = 0, avgTAT = 0;

    printf("\n----- FCFS Scheduling -----\n");
    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d\n", p[i].pid);
        printf("Arrival Time : ");
        scanf("%d", &p[i].at);
        printf("Burst Time : ");
        scanf("%d", &p[i].bt);
    }

    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {
            if(p[i].at > p[j].at) {
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    int time = 0;
    for(i = 0; i < n; i++) {
        if(time < p[i].at)
            time = p[i].at;

        time += p[i].bt;
        p[i].ct = time;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - p[i].bt;

        avgWT += p[i].wt;
        avgTAT += p[i].tat;
    }

    printf("PID\tAT\tBT\tCT\tTAT\tWT\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("Average Turnaround Time = %.2f\n", avgTAT / n);
    printf("Average Waiting Time = %.2f\n", avgWT / n);

    printf("\nGantt Chart:\n|");
    for(i = 0; i < n; i++)
        printf(" P%d |", p[i].pid);
    printf("\n");
}

void sjf() {
    struct Process p[MAX];
    int n, i;
    int completed = 0, time = 0;
    int min, index;
    int visited[MAX] = {0};
    float avgWT = 0, avgTAT = 0;

    printf("\n***** SJF Scheduling *****\n");
    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d\n", p[i].pid);
        printf("Arrival Time : ");
        scanf("%d", &p[i].at);
        printf("Burst Time : ");
        scanf("%d", &p[i].bt);
    }

    printf("\n ***** Gantt Chart *****\n|");

    while(completed < n) {
        min = 9999;
        index = -1;

        for(i = 0; i < n; i++) {
            if(!visited[i] && p[i].at <= time && p[i].bt < min) {
                min = p[i].bt;
                index = i;
            }
        }

        if(index == -1) {
            time++;
        } else {
            printf(" P%d |", p[index].pid);
            time += p[index].bt;
            p[index].ct = time;
            p[index].tat = p[index].ct - p[index].at;
            p[index].wt = p[index].tat - p[index].bt;

            avgWT += p[index].wt;
            avgTAT += p[index].tat;
            visited[index] = 1;
            completed++;
        }
    }

    printf("\n\n-------------------------------------------------------------\n");
    printf("PID\tAT\tBT\tCT\tTAT\tWT\n");
    printf("-------------------------------------------------------------\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("-------------------------------------------------------------\n");
    printf("Average Turnaround Time = %.2f\n", avgTAT / n);
    printf("Average Waiting Time = %.2f\n", avgWT / n);
}

void srtf() {
    struct Process p[MAX];
    int rt[MAX];
    int n, i;
    int completed = 0, time = 0;
    int min, index;
    float avgWT = 0, avgTAT = 0;

    printf("\n----- SRTF Scheduling -----\n");
    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d\n", p[i].pid);
        printf("Arrival Time : ");
        scanf("%d", &p[i].at);
        printf("Burst Time : ");
        scanf("%d", &p[i].bt);
        rt[i] = p[i].bt;
    }

    printf("\nGantt Chart:\n|");

    while(completed < n) {
        min = 9999;
        index = -1;

        for(i = 0; i < n; i++) {
            if(p[i].at <= time && rt[i] > 0 && rt[i] < min) {
                min = rt[i];
                index = i;
            }
        }

        if(index == -1) {
            time++;
        } else {
            printf(" P%d |", p[index].pid);
            rt[index]--;
            time++;

            if(rt[index] == 0) {
                completed++;
                p[index].ct = time;
                p[index].tat = p[index].ct - p[index].at;
                p[index].wt = p[index].tat - p[index].bt;

                if(p[index].wt < 0) p[index].wt = 0;

                avgWT += p[index].wt;
                avgTAT += p[index].tat;
            }
        }
    }

    printf("\n\n-------------------------------------------------------------\n");
    printf("PID\tAT\tBT\tCT\tTAT\tWT\n");
    printf("-------------------------------------------------------------\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("-------------------------------------------------------------\n");
    printf("Average Turnaround Time = %.2f\n", avgTAT / n);
    printf("Average Waiting Time = %.2f\n", avgWT / n);
}

void priority() {
    struct Process p[MAX];
    int visited[MAX] = {0};
    int n, i;
    int completed = 0, time = 0;
    int index, highest;
    float avgWT = 0, avgTAT = 0;

    printf("\n----- Priority Scheduling -----\n");
    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d\n", p[i].pid);
        printf("Arrival Time : ");
        scanf("%d", &p[i].at);
        printf("Burst Time : ");
        scanf("%d", &p[i].bt);
        printf("Priority (Smaller number = Higher Priority): ");
        scanf("%d", &p[i].priority);
    }

    printf("\nGantt Chart:\n|");

    while(completed < n) {
        highest = 9999;
        index = -1;

        for(i = 0; i < n; i++) {
            if(!visited[i] && p[i].at <= time) {
                if(p[i].priority < highest) {
                    highest = p[i].priority;
                    index = i;
                }
            }
        }

        if(index == -1) {
            time++;
        } else {
            printf(" P%d |", p[index].pid);
            time += p[index].bt;
            p[index].ct = time;
            p[index].tat = p[index].ct - p[index].at;
            p[index].wt = p[index].tat - p[index].bt;

            avgWT += p[index].wt;
            avgTAT += p[index].tat;
            visited[index] = 1;
            completed++;
        }
    }

    printf("\n\n-------------------------------------------------------------\n");
    printf("PID\tAT\tBT\tPR\tCT\tTAT\tWT\n");
    printf("-------------------------------------------------------------\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].priority, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("-------------------------------------------------------------\n");
    printf("Average Turnaround Time = %.2f\n", avgTAT / n);
    printf("Average Waiting Time = %.2f\n", avgWT / n);
}

void roundRobin() {
    struct Process p[MAX];
    int remBT[MAX];
    int n, tq, i;
    int completed = 0, time = 0;
    float avgWT = 0, avgTAT = 0;

    printf("\n----- Round Robin Scheduling -----\n");
    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d\n", p[i].pid);
        printf("Arrival Time : ");
        scanf("%d", &p[i].at);
        printf("Burst Time : ");
        scanf("%d", &p[i].bt);
        remBT[i] = p[i].bt;
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    printf("\nGantt Chart:\n|");

    while(completed < n) {
        int doneAnything = 0;

        for(i = 0; i < n; i++) {
            if(p[i].at <= time && remBT[i] > 0) {
                doneAnything = 1;
                printf(" P%d |", p[i].pid);

                if(remBT[i] > tq) {
                    time += tq;
                    remBT[i] -= tq;
                } else {
                    time += remBT[i];
                    remBT[i] = 0;
                    completed++;

                    p[i].ct = time;
                    p[i].tat = p[i].ct - p[i].at;
                    p[i].wt = p[i].tat - p[i].bt;

                    avgWT += p[i].wt;
                    avgTAT += p[i].tat;
                }
            }
        }
        if(!doneAnything) {
            time++;
        }
    }

    printf("\n\n-------------------------------------------------------------\n");
    printf("PID\tAT\tBT\tCT\tTAT\tWT\n");
    printf("-------------------------------------------------------------\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("-------------------------------------------------------------\n");
    printf("Average Turnaround Time = %.2f\n", avgTAT / n);
    printf("Average Waiting Time = %.2f\n", avgWT / n);
}
